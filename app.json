{
  "expo": {
    "name": "Cruxe",
    "slug": "cruxe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/png/icon.png",
    "scheme": "cruxe",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/brand/png/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cruxe.app",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.cruxe.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/png/adaptive-icon.png",
        "backgroundImage": "./assets/brand/png/adaptive-icon-background.png",
        "monochromeImage": "./assets/brand/png/adaptive-icon-monochrome.png",
        "backgroundColor": "#e8c630"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/brand/png/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1042059769347-31fuo35i64l5l0ap3tgt47t2v33k0t59"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "sam-cladson",
          "project": "cruxe"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#eecd2b",
          "defaultChannel": "cruxe-reminders",
          "icon": "./assets/brand/png/notification-icon.png"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "31320b61-e5f6-4376-908b-be11c13b417e"
      }
    },
    "owner": "samcladson"
  }
}
