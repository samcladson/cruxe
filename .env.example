# Copy to `.env` and fill in. Expo loads .env for `npx expo run:*` / Metro.

# Supabase (required for auth + puzzles)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Sign-In: Web client ID (OAuth 2.0 "Web application" in Google Cloud).
# Android also needs a separate *Android* OAuth client: package com.cruxe.app + SHA-1.
# Run scripts\print-android-debug-sha1.cmd (or .ps1 with -ExecutionPolicy Bypass).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# RevenueCat public SDK keys (Project → API keys in dashboard)
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=

# Crash reporting (optional in dev; set before shipping a release build).
# Sourcemap upload additionally needs SENTRY_AUTH_TOKEN in the EAS build env.
EXPO_PUBLIC_SENTRY_DSN=

# ─────────────────────────────────────────────────────────────────────
# Server-only secrets. These belong in Supabase Edge Function secrets
# (`npx supabase secrets set ...`) or GitHub Actions secrets — never in
# this file, and never behind an EXPO_PUBLIC_ prefix, which embeds the
# value in the shipped app bundle.
#
#   REVENUECAT_WEBHOOK_SECRET    shared secret for the webhook endpoint
#   REVENUECAT_SECRET_API_KEY    RevenueCat REST API key (v1 secret key)
#   SUPABASE_SERVICE_ROLE_KEY    full-access DB key
#   GEMINI_API_KEY               puzzle generation, GitHub Actions only
#
# Integration tests read these from the environment and skip if unset:
#   SUPABASE_TEST_URL
#   SUPABASE_TEST_ANON_KEY
#   SUPABASE_TEST_SERVICE_ROLE_KEY
# ─────────────────────────────────────────────────────────────────────
