{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // The modules under supabase/functions/_shared are imported by BOTH the
    // Deno Edge Functions and the Metro client. Deno requires explicit .ts
    // extensions on relative imports; this lets tsc accept them too.
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", "supabase/functions"]
}
